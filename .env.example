# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------- branding and port
ORG_NAME=Punjab National Bank
ORG_SHORT=PNB
ORG_UNIT=Data Analytics and Strategic Innovation Division
APP_NAME=PNB Regulatory Sentinel
# Port the app listens on. 8090 avoids vLLM (8000) and ComfyUI (8188).
PORT=8090

# ---------------------------------------------------------------- Windows / Docker Desktop only (see MANUAL.md)
# Uncomment on Windows so every plain "docker compose ..." command uses the Windows file:
# COMPOSE_FILE=docker-compose.windows.yml
# Where Ollama runs, as seen from the container. Leave commented to use Ollama on this Windows PC.
# To use the GB10's models instead: OLLAMA_URL=http://<gb10-ip>:11434/v1
# OLLAMA_URL=http://host.docker.internal:11434/v1

# ---------------------------------------------------------------- sign-in, e-mail, embedding
# Login is off: the app is meant to sit inside the Top Management Dashboard, which has its own sign-in.
# Set AUTH_ENABLED=true to require a login when the app is used on its own.
AUTH_ENABLED=false
# E-mail alerts and "e-mail me" are off. Set EMAIL_ENABLED=true and fill the e-mail section to use them.
EMAIL_ENABLED=false
# Which sites may show this app in an iframe. "*" = any. In production use the dashboard's address,
# e.g. FRAME_ANCESTORS=https://tmd.pnb.bank.in
FRAME_ANCESTORS=*
# Which sites may call the API from a browser (comma separated). Add the dashboard's address.
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------- security (used only when AUTH_ENABLED=true)
# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=sireejaa.uppal@pnb.bank.in
ADMIN_NAME=Sireejaa Uppal
# Temporary password for the first sign-in; the app asks you to change it.
ADMIN_PASSWORD=ChangeMe@12345
PUBLIC_URL=http://localhost:8090

# ---------------------------------------------------------------- e-mail (used only when EMAIL_ENABLED=true)
# Gmail requires an App Password (Google Account > Security > 2-Step Verification > App passwords).
# Leave SMTP_PASSWORD empty to run in dry-run mode: e-mails are written to data/outbox/*.eml instead of sent.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=sireejaa16@gmail.com
SMTP_PASSWORD=
EMAIL_FROM=sireejaa16@gmail.com
EMAIL_FROM_NAME=PNB RBI Sentinel
DEFAULT_RECIPIENTS=sireejaa.uppal@pnb.bank.in

# ---------------------------------------------------------------- RBI sources
RBI_FEEDS=notification=https://rbi.org.in/notifications_rss.xml,press_release=https://rbi.org.in/pressreleases_rss.xml
# Master Circulars and Master Directions have no RSS feed; these listing pages are read instead.
# Leave a value empty to switch that source off.
MASTER_CIRCULARS_URL=https://rbi.org.in/Scripts/BS_ViewMasterCirculardetails.aspx
MASTER_DIRECTIONS_URL=https://rbi.org.in/Scripts/BS_ViewMasterDirections.aspx
# Master Circular financial years to read: "all" (every year incl. Archives) or a number of years back.
# A headless browser clicks each year link; older years are re-read once a day.
MASTER_CIRCULAR_YEARS=all
# Documents ingested per run; while a backlog remains the next run starts straight away.
MAX_ITEMS_PER_SYNC=60
BACKFILL_CONTINUOUS=true
# Every current document gets an AI summary in the background (a few every 5 minutes), and immediately
# when someone opens it. Older yearly versions of master circulars are skipped.
AI_SUMMARY_QUEUE_ENABLED=true
AI_SUMMARY_BATCH=6
AI_SUMMARY_INTERVAL_MINUTES=5
SYNC_INTERVAL_MINUTES=30
SYNC_ON_STARTUP=true
# First run indexes the ~20 items already in the feeds silently, then alerts only on genuinely new ones.
NOTIFY_ON_FIRST_SYNC=false
DIGEST_THRESHOLD=4
FETCH_DETAIL_PAGE=true
HTTP_VERIFY_SSL=true

# ---------------------------------------------------------------- language model
# Option A - Ollama on the GB10 (ollama pull gpt-oss:20b). docker-compose uses host networking,
# so localhost works from inside the container too.
LLM_PROVIDER=openai_compat
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gpt-oss:20b
# Option B - vLLM:     LLM_BASE_URL=http://localhost:8000/v1   LLM_MODEL=<served model name>
# Option C - Claude:   LLM_PROVIDER=anthropic   ANTHROPIC_API_KEY=...   ANTHROPIC_MODEL=claude-sonnet-5-5
# Option D - no model: LLM_PROVIDER=none  (rules + extractive summaries; everything else still works)
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1800

# ---------------------------------------------------------------- retrieval
# Default: embeddings from Ollama on the GB10 GPU (ollama pull bge-m3). No downloads from inside the container.
# Alternative: EMBEDDING_PROVIDER=fastembed  EMBEDDING_MODEL=BAAI/bge-small-en-v1.5  (CPU, downloads ~130 MB once).
# Changing the embedding model later is safe: stored passages are re-embedded automatically at start-up.
EMBEDDING_PROVIDER=openai_compat
EMBEDDING_MODEL=bge-m3
EMBEDDING_BASE_URL=http://localhost:11434/v1
RERANKER_ENABLED=false
RETRIEVAL_TOP_K=6

# ---------------------------------------------------------------- storage
# Empty = SQLite in data/. For PostgreSQL: postgresql+psycopg://user:pass@host:5432/sentinel
DATABASE_URL=
LOG_LEVEL=INFO
